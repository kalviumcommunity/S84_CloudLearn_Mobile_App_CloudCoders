rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Student profile photos: users/{uid}/profile.jpg
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Assignment uploads: assignments/{assignmentId}/{uid}-{timestamp}-{filename}
    match /assignments/{assignmentId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && fileName.matches('^' + request.auth.uid + '-.*$');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
