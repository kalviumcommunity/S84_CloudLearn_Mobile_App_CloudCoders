rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Assignment submissions are private to the submitting student.
    match /assignment_submissions/{submissionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.status is string
        && (!('answerText' in request.resource.data)
            || request.resource.data.answerText is string);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.status is string
        && (!('answerText' in request.resource.data)
            || request.resource.data.answerText is string);
      allow delete: if false;
    }

    // Student profile is editable by the owner only.
    match /user_profiles/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Existing app tasks remain available to authenticated users.
    match /tasks/{taskId} {
      allow read, write: if isSignedIn();
    }
  }
}
