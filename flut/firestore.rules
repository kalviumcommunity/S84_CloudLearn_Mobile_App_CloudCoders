rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnlyKeys(data, allowedKeys) {
      return data.keys().hasOnly(allowedKeys);
    }

    // Assignment submissions are private to the submitting student.
    match /assignment_submissions/{submissionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && hasOnlyKeys(request.resource.data, [
          'assignmentId',
          'userId',
          'answerText',
          'fileUrl',
          'fileName',
          'status',
          'submittedAt',
          'updatedAt',
        ]);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.assignmentId == resource.data.assignmentId;
      allow delete: if false;
    }

    // Student profile is editable by the owner only.
    match /user_profiles/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Assignment catalog is readable by authenticated students.
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Task data is private per user.
    match /tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.completed is bool
        && hasOnlyKeys(request.resource.data, [
          'title',
          'userId',
          'createdAt',
          'updatedAt',
          'completed',
        ]);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
