rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Assignment submissions are private to the submitting student.
    match /assignment_submissions/{submissionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Student profile is editable by the owner only.
    match /user_profiles/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Existing app tasks remain available to authenticated users.
    match /tasks/{taskId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isNonEmptyString(request.resource.data.title, 200)
        && request.resource.data.createdAt is timestamp
        && (!('completed' in request.resource.data)
            || request.resource.data.completed is bool);

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isNonEmptyString(request.resource.data.title, 200)
        && (!('completed' in request.resource.data)
            || request.resource.data.completed is bool);

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
